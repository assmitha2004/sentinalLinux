[Unit]
Description=SentinelAI backend API
After=network-online.target mongod.service
Wants=network-online.target

[Service]
Type=simple
User=sentinelai-api
Group=sentinelai-api
WorkingDirectory=/opt/sentinelai/server
EnvironmentFile=/etc/sentinelai/server.env
ExecStart=/usr/bin/node src/server.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
