{
  "name": "sentinelai-server",
  "version": "1.0.0",
  "description": "SentinelAI backend API (Express + MongoDB + Socket.IO)",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/server.js",
