# ---- SentinelAI backend ----
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/sentinelai
# Generate: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=8h
# Optional shared bootstrap enrollment secret (multi-use). Prefer one-time tokens from Settings.
AGENT_ENROLLMENT_SECRET=
CORS_ORIGIN=http://localhost:5173
ALLOW_REGISTRATION=true
TRUST_PROXY=false

# ---- AI (optional; deterministic engine is used when unset) ----
# AI_PROVIDER=anthropic | openai   (openai = any OpenAI-compatible API incl. local Ollama/vLLM via AI_BASE_URL)
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
AI_TIMEOUT_MS=60000

# ---- Host status / alerting ----
HEARTBEAT_INTERVAL_SEC=30
DEGRADED_MULTIPLIER=2
OFFLINE_MULTIPLIER=4
ALERT_COOLDOWN_MIN=30

# ---- Retention (days) ----
RETENTION_METRICS_DAYS=7
RETENTION_FINDINGS_DAYS=90
RETENTION_ALERTS_DAYS=90
RETENTION_AUDIT_DAYS=180
RETENTION_SCANS_DAYS=90

# ---- Anomaly detection ----
ML_MIN_SAMPLES=500
ML_Z_THRESHOLD=4
